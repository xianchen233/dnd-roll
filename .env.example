# Copy to .env and replace every CHANGE_ME value before starting Compose.
POSTGRES_DB=dnd_roll
POSTGRES_USER=dnd_roll
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
APP_PORT=8080
# Set true when the browser reaches the application through HTTPS.
SESSION_COOKIE_SECURE=false
# Empty for a clean application. 'demo' creates a first campaign and two accounts.
SPRING_PROFILES_ACTIVE=demo
DEMO_DM_USERNAME=dm
DEMO_DM_PASSWORD=CHANGE_ME_DM_PASSWORD
DEMO_PLAYER_USERNAME=player
DEMO_PLAYER_PASSWORD=CHANGE_ME_PLAYER_PASSWORD
