# Copy to .env and replace every CHANGE_ME value before starting Compose.
POSTGRES_DB=dnd_roll
POSTGRES_USER=dnd_roll
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
APP_PORT=8080
# Set true when the browser reaches the application through HTTPS.
SESSION_COOKIE_SECURE=false
# Optional, explicit deployment-wide backup authority (independent of campaign DM).
# Leave blank to disable management and automatic jobs; set an existing account.
BACKUP_OPERATOR_USERNAME=
BACKUPS_DAILY_ENABLED=true
BACKUPS_RETENTION=7
# Normal setup creates only this fixed account; create campaigns in the UI.
BOOTSTRAP_USERNAME=owner
BOOTSTRAP_PASSWORD=CHANGE_ME_OWNER_PASSWORD
# Optional: 'demo' also creates the original sample campaign and two accounts.
SPRING_PROFILES_ACTIVE=
DEMO_DM_USERNAME=dm
DEMO_DM_PASSWORD=CHANGE_ME_DM_PASSWORD
DEMO_PLAYER_USERNAME=player
DEMO_PLAYER_PASSWORD=CHANGE_ME_PLAYER_PASSWORD
